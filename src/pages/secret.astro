---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = 'Quick Links';
const pageDescription = 'Internal quick access links and resources';

const links = [
  {
    title: 'Intake Form Link',
    url: 'https://forms.gle/qR6MqLiBLA9gJBGXA',
    icon: 'form'
  },
  {
    title: 'Response Records',
    url: 'https://docs.google.com/spreadsheets/d/1ugim1QtYfpLwBBFj8qQDNIUGDgjdVtSnuu7uvfYBtK0/edit?usp=sharing',
    icon: 'sheet'
  },
  {
    title: 'Decap CMS Admin',
    url: '/admin/index.html#/',
    icon: 'admin'
  }
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} />
    <style>
      .link-card {
        transition: all 0.2s ease;
        border: 1px solid var(--color-border-light);
        background: var(--color-bg-primary);
      }
      .link-card:hover {
        border-color: var(--accent);
        box-shadow: 0 4px 12px rgba(30, 56, 106, 0.1);
        transform: translateY(-2px);
      }
      .icon-wrapper {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--color-bg-secondary);
        transition: all 0.2s ease;
      }
      .link-card:hover .icon-wrapper {
        background: var(--accent);
      }
      .link-card:hover .icon-wrapper svg {
        stroke: white;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="max-w-2xl mx-auto px-4 py-8">
      <!-- Page Header -->
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-foreground mb-2">
          Quick Links
        </h1>
        <div class="w-16 h-1 bg-[color:var(--accent)] mx-auto rounded-full"></div>
      </div>

      <!-- Links List -->
      <div class="space-y-3">
        {links.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="link-card flex items-center gap-4 p-4 rounded-lg no-underline group"
          >
            <div class="icon-wrapper flex-shrink-0">
              {link.icon === 'form' && (
                <svg class="w-5 h-5 text-[color:var(--accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
              {link.icon === 'sheet' && (
                <svg class="w-5 h-5 text-[color:var(--accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              )}
              {link.icon === 'admin' && (
                <svg class="w-5 h-5 text-[color:var(--accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
            </div>
            <div class="flex-1">
              <h3 class="text-base font-semibold text-foreground group-hover:text-[color:var(--accent)] transition-colors">
                {link.title}
              </h3>
            </div>
            <svg
              class="w-5 h-5 text-[color:var(--color-text-muted)] group-hover:text-[color:var(--accent)] transition-colors flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
